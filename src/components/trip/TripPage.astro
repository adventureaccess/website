---
/**
 * TripPage — renders one trip file (src/content/trips/*.json) as a full,
 * standalone page in Brian's itinerary framework design.
 *
 * Standalone on purpose: the framework pages have their own brand bar, hero and
 * footer, so this does not use Base.astro (no site nav, no analytics, no consent
 * banner). It is only rendered under /internal/trips/ in Phase 1.
 *
 * CSS is Brian's framework stylesheet (framework/itinerary-template.html v1.0),
 * unchanged, plus four additions at the end: the internal review bar, the
 * two-track day lines, the price block, and the included / not included lists.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  trip: CollectionEntry<'trips'>;
  /** Show the internal review bar (status, source link). */
  review?: boolean;
}

const { trip, review = true } = Astro.props;
const t = trip.data;

const dayRange = (a: number, b: number) => (a === b ? `${a}` : `${a}–${b}`);
const money = (n: number) => '$' + n.toLocaleString('en-US');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#1A1612" />
  <title>{t.seo.title}</title>
  <meta name="description" content={t.seo.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body style={`--hero-img: url('${t.hero.image}')`}>

  {review && (
    <div class="review-bar">
      <span><strong>Internal preview</strong> · status: {t.status} · visibility: {t.visibility}</span>
      <span>
        <a href="/internal/trips/">All trips</a>
        {t.source?.youli && <> · <a href={t.source.youli} target="_blank" rel="noopener">Compare with YouLi</a></>}
      </span>
    </div>
  )}

  <!-- HERO -->
  <section class="hero">
    <div class="brand-bar">
      <a class="brand-mark" href="https://www.adventure-access.com">Adventure <em>Access</em></a>
      <span class="brand-tier">{t.preparedFor ? `Prepared for ${t.preparedFor}` : 'Journey Overview'}</span>
    </div>
    <div class="hero-bg" role="img" aria-label={t.hero.imageAlt}></div>
    <div class="hero-content">
      <p class="hero-eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}{t.hero.titleEm && <><br /><em>{t.hero.titleEm}</em></>}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <div class="hero-meta">
        {t.hero.meta.map((m, i) => (
          <>
            {i > 0 && <div class="hero-divider"></div>}
            <div class="hero-meta-item"><span>{m.label}</span><strong>{m.value}</strong></div>
          </>
        ))}
      </div>
    </div>
    <div class="scroll-indicator"><div class="scroll-line"></div>Scroll</div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="intro-inner">
      <span class="section-label">{t.intro.label}</span>
      <h2>{t.intro.heading}</h2>
      {t.intro.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- STATS -->
  {t.stats.length > 0 && (
    <div class="stats">
      {t.stats.map((s) => (
        <div class="stat"><span class="stat-number">{s.value}</span><span class="stat-label">{s.label}</span></div>
      ))}
    </div>
  )}

  <!-- ROUTE BAR -->
  {t.route.length > 0 && (
    <div class="route-bar">
      <div class="route-inner">
        {t.route.map((r, i) => (
          <>
            {i > 0 && <div class="route-line"></div>}
            <div class="route-stop"><div class="route-dot"></div><div class="route-stop-name">{r.name}</div><div class="route-stop-days">{r.days}</div></div>
          </>
        ))}
      </div>
    </div>
  )}

  <!-- PHOTO STRIP 1 -->
  {t.photoStrips[0] && (
    <div class="photo-strip">
      {t.photoStrips[0].map((p) => <div class="photo-strip-img"><img src={p.src} alt={p.alt} loading="lazy" /></div>)}
    </div>
  )}

  <!-- HOW THE DAYS WORK -->
  {t.dayTypes && (
    <section class="band band-cream-dark">
      <div class="wrap center">
        <span class="section-label">{t.dayTypes.label}</span>
        <h2 class="section-h2">{t.dayTypes.heading}</h2>
        <p class="lede wrap-narrow">{t.dayTypes.lede}</p>
        <div class="ways-grid">
          {t.dayTypes.cards.map((c) => (
            <div class={`way-card ${c.tone === 'gentle' ? 'gentle' : ''}`}><h3>{c.title}</h3><p>{c.body}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CHAPTERS -->
  <section class="days-section">
    <div class="days-header">
      <span class="section-label">{t.chapters.label}</span>
      <h2>{t.chapters.heading}</h2>
      {t.chapters.lede && <p>{t.chapters.lede}</p>}
    </div>
    {t.chapters.groups.map((g) => (
      <div class="day-group">
        <div class="day-group-header">
          <div class="day-number-block">
            <span class={`day-num ${dayRange(g.dayStart, g.dayEnd).length > 4 ? 'day-num-long' : ''}`}>{dayRange(g.dayStart, g.dayEnd)}</span>
            <span class="day-word">{g.dayStart === g.dayEnd ? 'Day' : 'Days'}</span>
          </div>
          <div class="day-header-content">
            <div class="day-title">{g.title}</div>
            {g.tags.length > 0 && <div class="day-meta-row">{g.tags.map((tag) => <span class="day-meta-tag">{tag}</span>)}</div>}
          </div>
        </div>
        <div class="day-body">
          {g.badge && <div class="day-badge">{g.badge}</div>}
          {g.prose.map((p) => <p>{p}</p>)}
          <ul class="day-lines">
            {g.days.map((d) => (
              <li>
                <span class="d">{d.label}</span>
                <span>
                  {d.tracks?.map((tr) => <span class="track"><span class="track-name">{tr.name}</span>{tr.text}</span>)}
                  {d.text && <span class={d.tracks ? 'track track-all' : ''}>{d.text}</span>}
                </span>
              </li>
            ))}
          </ul>
          {g.overnight && <div class="overnight-note">{g.overnight}</div>}
        </div>
      </div>
    ))}
  </section>

  <!-- PULL QUOTE + PHOTO STRIP 2 -->
  {t.pullQuote && <div class="pull-quote"><blockquote>“{t.pullQuote}”</blockquote></div>}
  {t.photoStrips[1] && (
    <div class="photo-strip">
      {t.photoStrips[1].map((p) => <div class="photo-strip-img"><img src={p.src} alt={p.alt} loading="lazy" /></div>)}
    </div>
  )}

  <!-- HIGHLIGHTS -->
  {t.highlights.length > 0 && (
    <section class="highlights">
      <div class="wrap">
        <div class="highlights-header">
          <span class="section-label" style="color:var(--orange-light)">What Sets This Journey Apart</span>
          <h2>Journey Highlights</h2>
        </div>
        <div class="highlights-grid">
          {t.highlights.map((h) => (
            <div class="highlight-card photo">
              <div class="highlight-photo" style={`background-image:url('${h.image}')`} role="img" aria-label={h.imageAlt}></div>
              <div class="highlight-text"><span class="highlight-where">{h.where}</span><h3>{h.title}</h3><p>{h.body}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- GOOD TO KNOW -->
  {t.goodToKnow && (
    <section class="band" style="background:var(--cream)">
      <div class="wrap center">
        <span class="section-label">{t.goodToKnow.label}</span>
        <h2 class="section-h2">{t.goodToKnow.heading}</h2>
        {t.goodToKnow.lede && <p class="lede wrap-narrow">{t.goodToKnow.lede}</p>}
        <div class="ways-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
          {t.goodToKnow.cards.map((c, i) => (
            <div class={`way-card ${i % 2 ? 'gentle' : ''}`}><h3>{c.title}</h3><p>{c.body}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- WHERE YOU'LL STAY -->
  {t.stays && (
    <section class="band band-cream-dark">
      <div class="wrap center">
        <span class="section-label">{t.stays.label}</span>
        <h2 class="section-h2">{t.stays.heading}</h2>
        {t.stays.paragraphs.map((p) => <p class="lede wrap-narrow">{p}</p>)}
        {t.stays.tags.length > 0 && <div class="accom-types">{t.stays.tags.map((tag) => <span class="accom-tag">{tag}</span>)}</div>}
      </div>
    </section>
  )}

  <!-- PRICE + INCLUDED -->
  {(t.pricing || t.included.length > 0) && (
    <section class="band" style="background:var(--white)">
      <div class="wrap">
        {t.pricing && (
          <div class="price center">
            <span class="section-label">Price</span>
            <div class="price-fig"><small>Starting at</small> {money(t.pricing.from)} <small>{t.pricing.currency}</small></div>
            <div class="price-basis">{t.pricing.basis}</div>
            {t.pricing.notes.map((n) => <p class="lede wrap-narrow">{n}</p>)}
          </div>
        )}
        {(t.included.length > 0 || t.excluded.length > 0) && (
          <div class="inc-grid">
            {t.included.length > 0 && (
              <div><h3 class="inc-h">Included</h3><ul class="inc-list">{t.included.map((x) => <li>{x}</li>)}</ul></div>
            )}
            {t.excluded.length > 0 && (
              <div><h3 class="inc-h">Not included</h3><ul class="inc-list exc">{t.excluded.map((x) => <li>{x}</li>)}</ul></div>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- NEXT STEPS -->
  <section class="cta">
    <span class="section-label" style="color:var(--orange-light)">{t.nextSteps.label}</span>
    <h2>{t.nextSteps.heading}</h2>
    <p>{t.nextSteps.lede}</p>
    <div class="steps">
      {t.nextSteps.steps.map((s, i) => (
        <div class="step"><div class="step-n">{String(i + 1).padStart(2, '0')}</div><h3>{s.title}</h3><p>{s.body}</p></div>
      ))}
    </div>
    <a class="btn" href={t.nextSteps.cta.href}>{t.nextSteps.cta.label}</a>
    {t.nextSteps.secondary && <p class="cta-secondary"><a href={t.nextSteps.secondary.href}>{t.nextSteps.secondary.label}</a></p>}
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-brand">Adventure Access</div>
    <div class="footer-tagline">Real Adventure Changes You</div>
    <div class="footer-divider"></div>
    <p>
      <a href="mailto:info@adventure-access.com">info@adventure-access.com</a> · <a href="https://www.adventure-access.com">adventure-access.com</a>
      {t.footerNote.map((n) => <><br />{n}</>)}
    </p>
  </footer>
</body>
</html>

<style is:global>
  /* ===== BRAND TOKENS (Brian's framework, do not change per trip) ===== */
  :root {
    --orange: #E8631A;
    --orange-light: #F2874A;
    --dark: #1A1612;
    --charcoal: #2C2420;
    --warm-mid: #6B5B4E;
    --warm-light: #C4A882;
    --cream: #F7F2EB;
    --cream-dark: #EDE5D8;
    --white: #FDFAF6;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Jost', system-ui, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { background: var(--white); color: var(--charcoal); font-family: var(--sans); font-weight: 300; line-height: 1.7; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; }
  a { color: var(--orange); }
  strong { font-weight: 500; }

  .brand-bar { position: absolute; top: 0; left: 0; right: 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; padding: 1.4rem 2rem; }
  .brand-mark { font-family: var(--serif); font-size: 1.15rem; letter-spacing: 0.04em; color: var(--white); text-decoration: none; }
  .brand-mark em { color: var(--orange-light); font-style: italic; }
  .brand-tier { font-size: 0.6rem; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(253,250,246,0.6); }

  .hero { position: relative; height: 100vh; min-height: 680px; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: var(--dark); }
  .hero-bg { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26,22,18,0.35) 0%, rgba(26,22,18,0.55) 60%, rgba(26,22,18,0.82) 100%), var(--hero-img) center/cover no-repeat; }
  .hero-content { position: relative; z-index: 2; padding: 2rem; max-width: 860px; }
  .hero-eyebrow { font-weight: 500; font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--orange-light); margin-bottom: 1.6rem; }
  .hero h1 { font-family: var(--serif); font-weight: 300; font-size: clamp(3rem, 8vw, 6.5rem); line-height: 1.0; color: var(--white); margin-bottom: 0.5rem; letter-spacing: -0.01em; }
  .hero h1 em { font-style: italic; color: var(--warm-light); }
  .hero-subtitle { font-family: var(--serif); font-size: clamp(1.1rem, 2.5vw, 1.5rem); color: rgba(253,250,246,0.75); font-weight: 300; font-style: italic; margin: 1.2rem 0 2.4rem; letter-spacing: 0.02em; }
  .hero-meta { display: flex; justify-content: center; gap: 2.5rem; flex-wrap: wrap; }
  .hero-meta-item { text-align: center; }
  .hero-meta-item span { display: block; font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--orange-light); margin-bottom: 0.3rem; }
  .hero-meta-item strong { font-family: var(--serif); font-size: 1.2rem; font-weight: 400; color: var(--white); }
  .hero-divider { width: 1px; height: 40px; background: rgba(253,250,246,0.3); align-self: center; }
  .scroll-indicator { position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%); z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: rgba(253,250,246,0.5); font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, transparent, rgba(253,250,246,0.4)); animation: scrollPulse 2s ease-in-out infinite; }
  @keyframes scrollPulse { 0%, 100% { opacity: 0.3; transform: scaleY(1); } 50% { opacity: 0.8; transform: scaleY(1.3); } }

  .section-label { font-size: 0.65rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--orange); margin-bottom: 1.2rem; display: block; font-weight: 400; }
  .section-h2 { font-family: var(--serif); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; line-height: 1.2; color: var(--dark); margin-bottom: 1.5rem; }
  .lede { font-size: 1.05rem; color: var(--warm-mid); line-height: 1.85; }
  .wrap { max-width: 1000px; margin: 0 auto; }
  .wrap-narrow { max-width: 760px; margin: 0 auto; }
  .band { padding: 5rem 2rem; }
  .band-cream-dark { background: var(--cream-dark); }
  .center { text-align: center; }

  .intro { background: var(--cream); padding: 5rem 2rem; text-align: center; }
  .intro-inner { max-width: 700px; margin: 0 auto; }
  .intro h2 { font-family: var(--serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; line-height: 1.2; color: var(--dark); margin-bottom: 1.5rem; }
  .intro p { font-size: 1.05rem; color: var(--warm-mid); line-height: 1.85; }
  .intro p + p { margin-top: 1rem; }

  .stats { background: var(--dark); padding: 3rem 2rem; display: flex; justify-content: center; flex-wrap: wrap; }
  .stat { text-align: center; padding: 1.5rem 3rem; border-right: 1px solid rgba(196,168,130,0.2); flex: 1; min-width: 150px; }
  .stat:last-child { border-right: none; }
  .stat-number { font-family: var(--serif); font-size: 3rem; font-weight: 300; color: var(--orange-light); line-height: 1; display: block; }
  .stat-label { font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(196,168,130,0.6); margin-top: 0.5rem; display: block; }

  .route-bar { background: var(--cream-dark); padding: 2rem; overflow-x: auto; }
  .route-inner { display: flex; align-items: center; justify-content: center; min-width: 560px; max-width: 800px; margin: 0 auto; }
  .route-stop { display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1; }
  .route-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--orange); margin-bottom: 0.5rem; }
  .route-stop-name { font-size: 0.62rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--charcoal); }
  .route-stop-days { font-size: 0.58rem; color: var(--warm-mid); margin-top: 0.15rem; }
  .route-line { flex: 1; height: 1px; background: linear-gradient(to right, var(--orange), var(--warm-light)); margin-bottom: 1.2rem; min-width: 20px; max-width: 60px; }

  .photo-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); height: 320px; overflow: hidden; background: var(--charcoal); }
  .photo-strip-img { overflow: hidden; min-width: 0; }
  .photo-strip-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .photo-strip-img:hover img { transform: scale(1.05); }

  .ways-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2.5rem; text-align: left; }
  .way-card { background: var(--white); padding: 1.8rem; border-radius: 4px; border-top: 3px solid var(--orange); }
  .way-card.gentle { border-top-color: var(--warm-light); }
  .way-card h3 { font-family: var(--serif); font-size: 1.35rem; font-weight: 500; color: var(--dark); margin-bottom: 0.5rem; }
  .way-card p { font-size: 0.92rem; color: var(--warm-mid); line-height: 1.75; }

  .days-section { padding: 5rem 2rem; max-width: 1000px; margin: 0 auto; }
  .days-header { text-align: center; margin-bottom: 4rem; }
  .days-header h2 { font-family: var(--serif); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; color: var(--dark); }
  .days-header p { color: var(--warm-mid); max-width: 620px; margin: 1rem auto 0; font-size: 0.98rem; }
  .day-group { margin-bottom: 3.5rem; }
  .day-group-header { display: grid; grid-template-columns: 80px 1fr; }
  .day-number-block { background: var(--orange); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.2rem 0.5rem; border-radius: 4px 0 0 0; }
  .day-num { white-space: nowrap; letter-spacing: -0.02em; font-family: var(--serif); font-size: 2rem; font-weight: 300; color: var(--white); line-height: 1; }
  .day-word { font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(253,250,246,0.7); margin-top: 0.1rem; }
  .day-header-content { background: var(--dark); padding: 1.2rem 1.8rem; border-radius: 0 4px 0 0; display: flex; flex-direction: column; justify-content: center; }
  .day-title { font-family: var(--serif); font-size: 1.4rem; font-weight: 400; color: var(--white); line-height: 1.2; }
  .day-meta-row { display: flex; gap: 0.4rem 1.5rem; margin-top: 0.4rem; flex-wrap: wrap; }
  .day-meta-tag { font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange-light); }
  .day-body { background: var(--cream); border-radius: 0 0 4px 4px; padding: 1.8rem 2rem; border-left: 3px solid var(--orange); }
  .day-body > p { font-size: 0.96rem; color: var(--warm-mid); line-height: 1.85; margin-bottom: 0.8rem; }
  .day-badge { display: inline-block; background: var(--orange); color: var(--white); font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.25rem 0.65rem; border-radius: 2px; margin-bottom: 0.9rem; font-weight: 500; }
  .day-lines { list-style: none; margin: 1rem 0 0.2rem; border-top: 1px solid rgba(196,168,130,0.35); }
  .day-lines li { display: grid; grid-template-columns: 64px 1fr; gap: 0.8rem; padding: 0.65rem 0; border-bottom: 1px solid rgba(196,168,130,0.22); font-size: 0.92rem; color: var(--charcoal); line-height: 1.65; }
  .day-lines .d { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); padding-top: 0.2rem; font-weight: 500; }
  .overnight-note { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.2rem; padding-top: 0.8rem; border-top: 1px solid rgba(196,168,130,0.3); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--warm-mid); }
  .overnight-note::before { content: '⌂'; font-size: 1rem; color: var(--orange); }

  .pull-quote { background: var(--orange); padding: 4rem 2rem; text-align: center; }
  .pull-quote blockquote { font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2.2rem); font-style: italic; font-weight: 300; color: var(--white); max-width: 700px; margin: 0 auto; line-height: 1.4; }

  .highlights { background: var(--dark); padding: 5rem 2rem; }
  .highlights-header { text-align: center; margin-bottom: 3.5rem; }
  .highlights-header h2 { font-family: var(--serif); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 300; color: var(--white); }
  .highlights-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .highlight-card { border: 1px solid rgba(196,168,130,0.2); padding: 2rem; border-radius: 4px; transition: border-color 0.3s; }
  .highlight-card:hover { border-color: var(--orange); }
  .highlight-card h3 { font-family: var(--serif); font-size: 1.25rem; font-weight: 400; color: var(--warm-light); margin-bottom: 0.6rem; }
