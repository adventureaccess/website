---
/**
 * IdentityWidgetGuard — loads netlify-identity-widget and works around a bug in it.
 *
 * THE BUG (confirmed against production, July 2026): the widget mounts a
 * full-viewport <iframe id="netlify-identity-widget"> at position:fixed,
 * z-index:99, pointer-events:auto. Calling netlifyIdentity.close() does NOT
 * shrink or hide it — measured at 1477x710 with pointer-events:auto immediately
 * after close(). The iframe is transparent, so the page looks normal but every
 * click and keystroke lands on the iframe instead of the page. Symptom: form
 * fields you can see but cannot type into.
 *
 * This bit us twice: on /account/ (couldn't type in the password-reset field
 * after a failed token) and it would have bitten /internal/dashboard/ too, where
 * the whole dashboard would be unclickable after logging in.
 *
 * THE FIX: mute the leftover iframe (pointer-events:none) whenever we're showing
 * our own UI, and unmute immediately before deliberately opening the widget so
 * its own modal still works. Muting is tracked with a data attribute so we only
 * ever clear styles we set ourselves.
 *
 * Use window.aaIdentity from page scripts rather than touching netlifyIdentity
 * directly, so this workaround stays in one place. If Identity is ever replaced
 * (it and Git Gateway are deprecated), this component and
 * netlify/functions/_identity.mjs are the two things to remove.
 */
---

<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

<script is:inline>
  (() => {
    const MIN_BLOCKING_PX = 300;

    const frames = () => [...document.querySelectorAll('iframe#netlify-identity-widget')];

    /** Disable pointer events on any leftover full-viewport widget iframe. */
    function mute() {
      frames().forEach((f) => {
        const b = f.getBoundingClientRect();
        if (b.width > MIN_BLOCKING_PX && b.height > MIN_BLOCKING_PX) {
          f.style.pointerEvents = 'none';
          f.dataset.aaMuted = '1';
        }
      });
    }

    /** Undo mute() — only clears what we set. */
    function unmute() {
      frames().forEach((f) => {
        if (f.dataset.aaMuted) {
          f.style.pointerEvents = '';
          delete f.dataset.aaMuted;
        }
      });
    }

    // The widget resizes its iframe asynchronously, so mute on a few ticks
    // rather than once.
    function muteSoon() {
      mute();
      [150, 400, 1000].forEach((ms) => setTimeout(mute, ms));
    }

    window.aaIdentity = {
      get: () => window.netlifyIdentity || null,
      mute,
      unmute,
      muteSoon,
      /** Open the widget deliberately (e.g. a Log in button). */
      open(pane) {
        const id = window.netlifyIdentity;
        if (!id) return;
        unmute();
        id.open(pane);
      },
      /** Close the widget AND stop its iframe swallowing clicks. */
      close() {
        const id = window.netlifyIdentity;
        try {
          id && id.close();
        } catch (_) {
          /* closing is best-effort */
        }
        muteSoon();
      },
    };

    // Whenever the widget reports it closed itself (user pressed X, flow
    // finished), make sure the iframe stops blocking. And when it opens — which
    // it does by itself for invite/recovery links, without going through
    // aaIdentity.open() — un-mute, or its own modal would be unclickable.
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('open', unmute);
      window.netlifyIdentity.on('close', muteSoon);
      window.netlifyIdentity.on('login', muteSoon);
      window.netlifyIdentity.on('logout', muteSoon);
    }
  })();
</script>
