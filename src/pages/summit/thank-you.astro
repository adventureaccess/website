---
/**
 * /summit/thank-you/ — conversion page for the ATWS 2026 meeting form.
 *
 * Campaign-specific rather than reusing /thank-you/ so the GA4 funnel for the
 * Summit stays separable from the paid-social campaigns and the /plan/ wizard.
 * noindex, and excluded from the sitemap.
 */
import Base from '../../layouts/Base.astro';
---
<Base
  title="Got it — see you in Québec | Adventure Access"
  description="Thanks for reaching out at the Adventure Travel World Summit. We'll come back with a time within 24 hours."
  noindex={true}
>
  <article class="pt-40 md:pt-48 pb-24 md:pb-32">
    <div class="max-w-2xl mx-auto px-6 md:px-14 text-center">
      <div class="eyebrow mb-6">— ATWS 2026 · Québec City</div>
      <h1 class="display text-5xl md:text-6xl mb-8">See you this week.</h1>
      <p class="text-lg md:text-xl leading-relaxed text-ink-soft mb-8">
        That landed with us. During the Summit we answer inside a few hours — expect a
        specific time and a place to meet, not a form letter. If you asked about the
        Bhutan concept, that reply comes from Brian directly.
      </p>
      <p class="text-ink-soft mb-12">
        Need us sooner? Write to
        <a class="text-saffron border-b border-saffron/40 hover:border-saffron transition-colors" href="mailto:info@adventure-access.com">info@adventure-access.com</a>
        — it goes to a phone that is in the room with you.
      </p>
    </div>
  </article>

  <!-- While you're here — keeps the visit going instead of dead-ending. -->
  <section class="bg-paper py-20 md:py-28">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="eyebrow mb-4 reveal">— While you have us open</div>
      <h2 class="display text-3xl md:text-5xl mb-12 reveal">Three minutes of homework on us.</h2>

      <div class="grid md:grid-cols-3 gap-10">
        <a href="/bhutan-travel-cost-sdf-2026/" class="reveal group block border-t-2 border-saffron pt-6">
          <h3 class="font-display text-xl md:text-2xl mb-3 group-hover:text-saffron-dark transition-colors">
            What Bhutan actually costs in 2026
          </h3>
          <p class="text-ink-soft leading-relaxed text-sm">
            The Sustainable Development Fee, plainly, with the numbers your clients will ask about.
          </p>
        </a>

        <a href="/tibet-without-a-permit-amdo-kham-2026/" class="reveal group block border-t-2 border-saffron pt-6" data-delay="100">
          <h3 class="font-display text-xl md:text-2xl mb-3 group-hover:text-saffron-dark transition-colors">
            The Tibetan Plateau without a Tibet permit
          </h3>
          <p class="text-ink-soft leading-relaxed text-sm">
            Amdo and Kham — Tibetan in every way that matters, and open. Most itineraries miss this.
          </p>
        </a>

        <a href="/destinations/" class="reveal group block border-t-2 border-saffron pt-6" data-delay="200">
          <h3 class="font-display text-xl md:text-2xl mb-3 group-hover:text-saffron-dark transition-colors">
            Every destination we run
          </h3>
          <p class="text-ink-soft leading-relaxed text-sm">
            Bhutan, Ladakh and the Indian Himalaya, Nepal, the Tibetan Plateau and Yunnan.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-ink text-cream py-16 md:py-20">
    <div class="max-w-8xl mx-auto px-6 md:px-14 text-center">
      <p class="display text-2xl md:text-4xl mb-8">Real adventure changes you.</p>
      <a href="/summit/" class="btn-ghost-cream">Back to the Summit page →</a>
    </div>
  </section>

  {/* Conversion event: an ATWS 2026 meeting request just completed. */}
  <script is:inline>
    (() => {
      let source = 'unattributed';
      try {
        source = sessionStorage.getItem('aa-summit-src') || 'unattributed';
      } catch (e) {}
      try {
        window.gtag && window.gtag('event', 'summit_lead', { summit_source: source });
      } catch (e) {}
      try {
        window.rdt && rdt('track', 'Lead');
      } catch (e) {}
    })();
  </script>
</Base>
