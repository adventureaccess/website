---
/**
 * 404 — brand-matched not-found page.
 *
 * Astro emits this to dist/404.html and Netlify serves it automatically for
 * unmatched paths on static sites (with a real 404 status). No netlify.toml
 * change needed.
 *
 * Worth keeping the "recently rebuilt" note: the site migrated from WordPress,
 * so a fair number of old inbound links point at paths that moved.
 */
import Base from '../layouts/Base.astro';

const elsewhere = [
  { href: '/destinations/', label: 'Destinations', note: 'Bhutan, Ladakh, Nepal, Yunnan' },
  { href: '/tours/', label: 'Book a Trip', note: 'Current small-group departures' },
  { href: '/blog/', label: 'The Journal', note: 'Field notes from the plateau' },
  { href: '/plan/', label: 'Plan a Journey', note: 'Five questions, about two minutes' },
];
---

<Base
  title="Page not found — Adventure Access"
  description="That page isn't here. Find your way back to our destinations, trips, and field notes from the Himalayas."
  noindex={true}
>
  <article class="pt-40 md:pt-48 pb-24 md:pb-32">
    <div class="max-w-3xl mx-auto px-6 md:px-14">
      <div class="eyebrow mb-6">— 404</div>
      <h1 class="display text-5xl md:text-7xl mb-8">
        This trail<br />doesn't <em class="not-italic font-light text-saffron font-display italic">exist</em>.
      </h1>
      <p class="text-lg md:text-xl leading-relaxed text-ink-soft mb-6">
        Either the link was wrong, or the page moved. We rebuilt this site recently, and a
        few old paths shifted in the process — the writing and the trips all made the trip
        over, just not always to the same address.
      </p>
      <p class="text-ink-soft mb-12">
        If you followed a link from somewhere else and think it should work, tell us at
        <a
          class="text-saffron border-b border-saffron/40 hover:border-saffron transition-colors"
          href="mailto:info@adventure-access.com">info@adventure-access.com</a>
        and we'll point it in the right direction.
      </p>

      <a href="/" class="btn !bg-saffron hover:!bg-saffron-dark inline-block">Back to home</a>
    </div>
  </article>

  <section class="bg-paper py-20 md:py-28">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="eyebrow mb-10">— Or start somewhere here</div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {elsewhere.map((item, i) => (
          <a
            href={item.href}
            class="reveal group bg-cream border border-ink/10 p-8 flex flex-col transition-colors hover:border-saffron/60"
            data-delay={i * 100}
          >
            <span class="font-display text-2xl text-ink mb-3 group-hover:text-saffron-dark transition-colors">
              {item.label}
            </span>
            <span class="text-sm leading-relaxed text-ink-soft">{item.note}</span>
            <span class="mt-6 text-saffron text-sm tracking-[0.05em] uppercase" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
