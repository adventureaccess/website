              <span class="absolute right-1 top-5 text-2xl leading-none text-saffron font-sans select-none hidden group-open:inline" aria-hidden="true">–</span>
            </summary>
            <div class="pb-7 pr-10 leading-relaxed text-ink-soft">{a}</div>
          </details>
        ))}

        <p class="mt-10 text-sm text-ink-soft tracking-wide">
          Last reviewed: {LAST_REVIEWED} · SDF rate confirmed through 31 August 2027
        </p>
      </div>
    </div>
  </section>

  {/* ---------- CTA ----------
      No NewsletterSignup here on purpose: Footer.astro already renders it (dark) on
