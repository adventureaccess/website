---
// src/pages/nepal-trekking-permits-2026.astro
// Pillar 2 of 4.
//
// COPY IS VERBATIM from the approved Drive doc "Text Approved — Nepal Trekking
// Permits 2026: EBC, Annapurna & Mustang". Do not reword it here. This copy has
// been through human approval; if it needs to change, change it at the doc and
// bring it across. An earlier version of this file rewrote the section headings,
// added an FAQ, added a CTA block, added a short-answer block and switched
// American spellings to British. All reverted.
//
// The ONLY copy-affecting changes are the four Will approved on 2026-07-29:
//   1. The doc links /destination/nepal/ and calls it "confirmed live". It is
//      /destinations/nepal — plural. Two broken links avoided.
//   2. The doc's CTA points at /contact/, which does not exist. Now /plan/.
//   3. The "Download our free Tibetan Plateau Trip Planner 2026" line is dropped:
//      no such download exists, and Footer.astro already renders the Monthly
//      Dispatch on every page, so an in-body block would be a second identical
//      HubSpot form.
//   4. "via a registered agency" added to the solo-trekker FAQ. Solo trekkers can
//      obtain restricted-area permits since March 2026, but the application still
//      goes through a registered trekking agency — without that, "solo" reads as
//      "on your own".
//
// Two further link resolutions, which change no prose: the doc's publishing
// checklist asks for the other pillars to be cross-linked, and those appear as
// bare links rather than new sentences.
//
// SHORT-ANSWER BLOCK: present, and built from the doc's own words. Search and AI
// assistants extract from a definitive early statement, but writing one normally
// means writing new copy. It doesn't here — the doc's opening paragraph already
// IS the summary, so it is promoted into the block verbatim and the article then
// begins at the second paragraph. Every word is the author's and each is used
// once. If this block ever needs different wording, write it at the doc.
//
// FACT-CHECK 2026-07-29, re-verified 2026-08-01: Upper Mustang $50/day (changed
// late 2025), solo restricted-area permits restored March 2026, TIMS no longer
// checked on EBC/Annapurna, ACAP ~NPR 3,000. All confirmed.
//
// WIRING: pillarUrls entry in sitemap.xml.ts + a `guides` entry on the nepal
// record in destinations.json. Root-level pages are in no collection, so nothing
// links or crawls them automatically.
//
// ANNUAL REFRESH: keep this URL. Nepal's rules have changed three times in three
// years — the doc's own caveat — so this page needs re-verification more than the
// others. Update LAST_REVIEWED_ISO and the sitemap lastmod together.

import Base from '../layouts/Base.astro';
import PillarHero from '../components/PillarHero.astro';
import PillarShortAnswer from '../components/PillarShortAnswer.astro';
import PillarFaq from '../components/PillarFaq.astro';
import { reviewedOn, faqSchema, articleSchema, type Faq } from '../utils/pillar';

const LAST_REVIEWED_ISO = '2026-08-01';
const LAST_REVIEWED = reviewedOn(LAST_REVIEWED_ISO);

const title = 'Nepal Trekking Permits 2026: EBC, Annapurna & Mustang';
const description =
  "Nepal's permit rules changed for 2026: Upper Mustang is now $50/day and solo trekkers are back. What you need for EBC, Annapurna & Mustang — explained simply.";

// Hero has genuine 800/1400/2000 variants (source is 2560px wide). The slider
// images below do not, so they use a plain src.
const HERO = '/images/2024/05/Nepal-Page-Hero-image-scaled-1.jpeg';
const IMG_TRAIL = '/images/2023/12/napal-slider06.jpg';
const IMG_NAMCHE = '/images/2023/12/napal-slider04.jpg';
const IMG_PASS = '/images/2023/12/napal-slider03.jpg';

// Verbatim from the doc's FAQ section — all five, in the doc's order. The only
// edit is the approved "via a registered agency" clarification in the solo answer.
const faqs: Faq[] = [
  {
    q: 'Do I still need a TIMS card in Nepal?',
    a: 'Not for Everest or Annapurna, where park/conservation permits replaced it at checkpoints. TIMS is still required for restricted areas like Upper Mustang ($20) and regions like Langtang and Manaslu.',
  },
  {
    q: 'How much is the Upper Mustang permit in 2026?',
    a: '$50 per person per day, replacing the old $500/10-day flat fee. Add ACAP (~$30) and TIMS ($20). A licensed guide is mandatory.',
  },
  {
    q: 'Can I trek Nepal solo in 2026?',
    a: 'Yes on non-restricted routes. And as of March 2026, solo trekkers can also obtain restricted-area permits via a registered agency (previously a two-trekker minimum) — though the mandatory-guide rule still applies in those areas.',
  },
  {
    q: 'What permits do I need for Everest Base Camp?',
    a: 'The Sagarmatha National Park entry permit and the Khumbu Pasang Lhamu municipality fee, both obtainable en route. No TIMS.',
  },
  {
    q: 'When is the best season for Upper Mustang?',
    a: 'Unusually, June–September works — Mustang sits in the rain shadow. October and April–May are ideal for most other routes.',
  },
];

const schema = [
  faqSchema(faqs),
  articleSchema({
    title,
    description,
    path: '/nepal-trekking-permits-2026/',
    image: HERO,
    reviewedIso: LAST_REVIEWED_ISO,
    site: Astro.site,
    about: [
      { '@type': 'Country', name: 'Nepal', sameAs: 'https://en.wikipedia.org/wiki/Nepal' },
      { '@type': 'Place', name: 'Upper Mustang', sameAs: 'https://en.wikipedia.org/wiki/Upper_Mustang' },
    ],
    mentions: [
      { '@type': 'Place', name: 'Mount Everest', sameAs: 'https://en.wikipedia.org/wiki/Mount_Everest' },
      { '@type': 'Place', name: 'Annapurna Massif', sameAs: 'https://en.wikipedia.org/wiki/Annapurna_Massif' },
      { '@type': 'Place', name: 'Sagarmatha National Park', sameAs: 'https://en.wikipedia.org/wiki/Sagarmatha_National_Park' },
    ],
  }),
];

// Verbatim from the doc's "At a glance" table.
const permitRows = [
  { trek: 'Everest Base Camp', needs: 'Sagarmatha NP permit + Khumbu municipality fee', guide: 'No (recommended)' },
  { trek: 'Annapurna routes', needs: 'ACAP (~$30)', guide: 'No (recommended)' },
  { trek: 'Upper Mustang', needs: 'RAP $50/day + ACAP + TIMS ($20)', guide: 'Yes — mandatory' },
  { trek: 'Manaslu Circuit', needs: 'Restricted permit + MCAP/ACAP + TIMS', guide: 'Yes — mandatory' },
  { trek: 'Langtang', needs: 'Langtang NP permit + TIMS', guide: 'No (recommended)' },
];

const seasons = [
  ['October–November', 'the classic season everywhere — stable air, sharp peaks, busy trails. Book lodges early.'],
  ['March–May', 'rhododendron forests in bloom on Annapurna and Everest approaches; warmer, hazier afternoons.'],
  ['June–September (monsoon)', 'the secret season for Upper Mustang and other rain-shadow treks, which stay dry while the south drenches.'],
  ['December–February', 'cold, clear, quiet. Lower treks shine; high passes close.'],
];
---

<Base
  title={title}
  description={description}
  ogImage={HERO}
  hideNavBg={true}
  schema={schema}
>
  <PillarHero
    eyebrow="— Nepal · Permits & Trekking"
    heading="Nepal Trekking Permits 2026: EBC, Annapurna & Mustang"
    intro="Nepal quietly rewrote its trekking permit rules over the past year, and most of the internet hasn't caught up."
    image={HERO}
    imageAlt="A sharp Himalayan summit above deep blue sky, Nepal"
    hasVariants={true}
    primaryHref="#permit-picture"
    primaryLabel="The permit picture"
    secondaryHref="/plan/"
    secondaryLabel="Plan a journey →"
  />

  {/* Verbatim: the doc's opening paragraph, promoted here so the facts land in the
      first screen. Not repeated below — the article picks up at paragraph two. */}
  <PillarShortAnswer>
    Nepal quietly rewrote its trekking permit rules over the past year, and most of the internet
    hasn't caught up. The headline changes for 2026:
    <strong class="text-ink font-medium">Upper Mustang's famous $500 permit is gone</strong>,
    replaced by a $50-per-day system — and as of March 2026,
    <strong class="text-ink font-medium">solo trekkers can get restricted-area permits again</strong>.
    Meanwhile TIMS, the card every guidebook tells you to buy, is no longer even checked in the
    Everest and Annapurna regions.
  </PillarShortAnswer>

  {/* ---------- Intro ---------- */}
  <section class="pt-16 md:pt-24 pb-24 md:pb-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="max-w-3xl space-y-6 text-lg leading-relaxed text-ink-soft">
        <p>
          We've been trekking Nepal for over twenty years — Everest Base Camp, the Annapurna
          Sanctuary, and the walled kingdom of Lo Manthang in Upper Mustang.
          <a href="/destinations/nepal/" class="text-saffron-dark underline underline-offset-4 hover:text-rust">See our Nepal destination page</a>.
          Here's what you actually need in 2026, route by route.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- The 2026 Permit Picture, Route by Route ---------- */}
  <section class="bg-paper py-24 md:py-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-5">— Permits</div>
        <h2 id="permit-picture" class="display text-4xl md:text-5xl mb-8 scroll-mt-28">
          The 2026 Permit Picture, Route by Route
        </h2>

        <h3 class="display text-2xl md:text-3xl mb-3">Everest Base Camp</h3>
        <p class="text-lg leading-relaxed text-ink-soft mb-8">
          No TIMS required. You need the <strong class="text-ink font-medium">Sagarmatha National
          Park entry permit</strong> plus the <strong class="text-ink font-medium">Khumbu Pasang
          Lhamu municipality fee</strong>, both payable en route (Lukla or Monjo). Straightforward —
          the harder currency on the EBC trail is lodge beds in October.
        </p>

        <h3 class="display text-2xl md:text-3xl mb-3">Annapurna (Circuit, Sanctuary, Poon Hill)</h3>
        <p class="text-lg leading-relaxed text-ink-soft mb-8">
          The <strong class="text-ink font-medium">Annapurna Conservation Area Permit (ACAP</strong> —
          NPR 3,000, roughly $30) has replaced TIMS at checkpoints. Buy it in Kathmandu or Pokhara
          before you start.
        </p>

        <h3 class="display text-2xl md:text-3xl mb-3">Upper Mustang — the big change</h3>
        <p class="text-lg leading-relaxed text-ink-soft mb-8">
          The old rule was a flat <strong class="text-ink font-medium">$500 for 10 days</strong>, a
          price that kept Lo Manthang among the least-visited great destinations in the Himalaya.
          Since late 2025 it's <strong class="text-ink font-medium">$50 per person per day</strong> —
          same money for ten days, but shorter trips are suddenly affordable, and longer explorations
          scale fairly. You still need three pieces of paper: the
          <strong class="text-ink font-medium">Restricted Area Permit ($50/day)</strong>,
          <strong class="text-ink font-medium">ACAP ($30)</strong>, and a
          <strong class="text-ink font-medium">TIMS card ($20)</strong> — yes, TIMS survives here.
          And one non-negotiable: a <strong class="text-ink font-medium">licensed guide is
          mandatory</strong> in Upper Mustang, checked rigorously at posts along the route.
        </p>

        <h3 class="display text-2xl md:text-3xl mb-3">Langtang, Manaslu &amp; far-western Nepal</h3>
        <p class="text-lg leading-relaxed text-ink-soft mb-10">
          TIMS remains required here, and Manaslu carries its own restricted-area permit with a guide
          requirement. Rules differ trek by trek — ask before you plan.
        </p>

        <h3 class="display text-2xl md:text-3xl mb-2">At a glance</h3>

        <div class="overflow-x-auto -mx-6 px-6 md:mx-0 md:px-0">
          <table class="w-full border-collapse min-w-[34rem] text-base">
            <caption class="sr-only">
              Trekking permits required in Nepal in 2026 by route, and whether a licensed guide is
              mandatory.
            </caption>
            <thead>
              <tr>
                <th scope="col" class="text-left py-4 pr-4 border-b border-ink/15 text-xs font-medium uppercase tracking-[0.15em] text-ink-soft">Trek</th>
                <th scope="col" class="text-left py-4 pr-4 border-b border-ink/15 text-xs font-medium uppercase tracking-[0.15em] text-ink-soft">What you need (2026)</th>
                <th scope="col" class="text-left py-4 border-b border-ink/15 text-xs font-medium uppercase tracking-[0.15em] text-ink-soft">Guide required?</th>
              </tr>
            </thead>
            <tbody>
              {permitRows.map(({ trek, needs, guide }) => (
                <tr>
                  <th scope="row" class="text-left font-normal py-4 pr-4 border-b border-ink/10 text-ink">{trek}</th>
                  <td class="py-4 pr-4 border-b border-ink/10 text-ink-soft">{needs}</td>
                  <td class:list={['py-4 border-b border-ink/10', guide.startsWith('Yes') ? 'text-ink font-medium' : 'text-ink-soft']}>
                    {guide}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="border-l-[3px] border-saffron pl-6 mt-10">
          <p class="text-lg leading-relaxed text-ink-soft">
            <strong class="text-ink font-medium">The honest caveat:</strong> Nepal's permit rules
            have changed three times in three years. Treat any article — including this one — as a
            snapshot, and confirm current rules when you book. We re-verify with every departure.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Why Upper Mustang Is the One to Watch ---------- */}
  <section class="py-24 md:py-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <div class="eyebrow mb-5">— The one to watch</div>
          <h2 class="display text-4xl md:text-5xl mb-8">Why Upper Mustang Is the One to Watch</h2>
          <p class="text-lg leading-relaxed text-ink-soft">
            The permit change matters because Upper Mustang is the closest thing to old Tibet that
            remains fully open to travelers: a walled capital at Lo Manthang, cave monasteries, arid
            canyons behind the Annapurna rain shadow — trekkable even in monsoon season, when the
            rest of Nepal drips. At $500 flat, it filtered out everyone but the committed. At
            $50/day, a 7-day taste is now $350 in permits — expect visitor numbers to climb. If Lo
            Manthang has been on your list, 2026–27 is the window before the word fully gets out.
          </p>
          <a href="/destinations/nepal/" class="btn-ghost mt-8">Mustang trips</a>
        </div>
        <img
          src={IMG_PASS}
          alt="Trekkers at a prayer-flag cairn on a high pass in Nepal, snow peaks behind"
          loading="lazy"
          class="w-full aspect-[16/10] object-cover reveal reveal-right"
        />
      </div>
    </div>
  </section>

  {/* ---------- When to Go ---------- */}
  <section class="bg-paper py-24 md:py-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <img
          src={IMG_TRAIL}
          alt="A stupa on the Everest Base Camp trail with Ama Dablam rising behind it"
          loading="lazy"
          class="w-full aspect-[16/10] object-cover reveal reveal-left"
        />
        <div>
          <div class="eyebrow mb-5">— Seasons</div>
          <h2 class="display text-4xl md:text-5xl mb-8">When to Go</h2>
          <ul class="space-y-4">
            {seasons.map(([when, what]) => (
              <li class="relative pl-6 text-lg leading-relaxed text-ink-soft">
                <span class="absolute left-0 top-[0.7em] w-1.5 h-1.5 rounded-full bg-saffron"></span>
                <strong class="text-ink font-medium">{when}:</strong> {what}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Independent vs. Guided: An Honest Take ---------- */}
  <section class="py-24 md:py-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <div class="eyebrow mb-5">— An honest take</div>
          <h2 class="display text-4xl md:text-5xl mb-8">Independent vs. Guided: An Honest Take</h2>
          <p class="text-lg leading-relaxed text-ink-soft">
            On EBC and Annapurna, independent trekking is legal and thousands do it happily. What a
            guide changes: route flexibility when weather closes a pass, lodge relationships in peak
            season, a margin of safety at altitude, and — the part we care most about — the
            connection to the places you walk through. On restricted routes (Mustang, Manaslu) the
            question is moot: the guide is required, so the real choice is between an operator who
            processes paperwork and one who has walked these trails for twenty years and knows which
            cave monastery the caretaker will actually open.
          </p>
        </div>
        <img
          src={IMG_NAMCHE}
          alt="A Khumbu village of brightly roofed lodges built into a mountainside, Nepal"
          loading="lazy"
          class="w-full aspect-[16/10] object-cover reveal reveal-right"
        />
      </div>
    </div>
  </section>

  <PillarFaq
    faqs={faqs}
    heading="FAQ"
    paper={true}
    reviewedNote={`Last reviewed: ${LAST_REVIEWED}`}
  />

  {/* ---------- Plan Your Trek ----------
      Cross-links only, per the doc's publishing checklist. No NewsletterSignup:
      Footer.astro already renders the Monthly Dispatch on every page. */}
  <section class="py-24 md:py-36">
    <div class="max-w-8xl mx-auto px-6 md:px-14">
      <div class="max-w-3xl">
        <div class="eyebrow mb-5">— Start a conversation</div>
        <h2 class="display text-4xl md:text-5xl mb-8">Plan Your Trek</h2>
        <p class="text-lg leading-relaxed text-ink-soft">
          Whether it's the classic walk to Everest Base Camp or the newly affordable road to Lo
          Manthang, we'll tell you exactly what paperwork your route needs this season — because
          we're re-checking it anyway for our own departures.
        </p>
        <div class="flex flex-wrap items-center gap-8 mt-10">
          <a href="/plan/" class="btn !bg-saffron hover:!bg-saffron-dark">Talk to our team</a>
          <a href="/destinations/nepal/" class="btn-ghost">Nepal trips</a>
        </div>
        <p class="mt-10 text-base text-ink-soft">
          <a href="/bhutan-travel-cost-sdf-2026/" class="text-saffron-dark underline underline-offset-4 hover:text-rust">Bhutan travel cost 2026</a>
          ·
          <a href="/tibet-without-a-permit-amdo-kham-2026/" class="text-saffron-dark underline underline-offset-4 hover:text-rust">Tibet without a permit</a>
        </p>
      </div>
    </div>
  </section>
</Base>
