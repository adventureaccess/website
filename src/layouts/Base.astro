---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RevealObserver from '../components/RevealObserver.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideNavBg?: boolean;
  /** Set true to emit a noindex tag (e.g. thank-you, search results). */
  noindex?: boolean;
  /** Optional extra JSON-LD blocks to append (Article, TouristTrip, Place, etc). */
  schema?: object | object[];
  /** BCP-47 language for <html lang>. Defaults to 'en'; set 'fr' for the
   *  French-language ATWS 2026 meeting pages so assistive tech, hyphenation
   *  and browser translate prompts behave correctly. */
  lang?: string;
}

const {
  title = 'Adventure Access — Real Adventure Changes You',
  description = 'Custom-built adventure tours across the Himalayas and the Tibetan Plateau. Bhutan, India, Nepal, and Yunnan.',
  ogImage,
  hideNavBg = false,
  noindex = false,
  schema,
  lang = 'en',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Internal, staff-only pages (/internal/*) get NO marketing or analytics
// scripts, and no consent banner. Two reasons:
//  1. Staff using our own tools shouldn't inflate the traffic and conversion
//     numbers the dashboard then reports — that's circular.
//  2. No tracking means no cookies to consent to, so the banner is pointless here.
const INTERNAL_PREFIXES = ['/internal'];
const isInternalPage = INTERNAL_PREFIXES.some((p) => Astro.url.pathname.startsWith(p));
const absoluteOgImage = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL('/images/2024/05/Ladakh-hero-image.jpg', Astro.site).toString();

// Organization schema — emitted on every page
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Adventure Access',
  legalName: 'Adventure Access, LLC',
  url: Astro.site?.toString() ?? 'https://www.adventure-access.com/',
  logo: new URL('/favicon.svg', Astro.site).toString(),
  description:
    'Custom adventure tours across the Himalayas and the Tibetan Plateau, with a community of local guides and operators in Bhutan, India, Nepal, and China.',
  areaServed: ['Bhutan', 'India', 'Nepal', 'China', 'Tibet'],
  knowsAbout: [
    'Himalayan trekking',
    'Tibetan Plateau travel',
    'Mountain biking',
    'Cultural immersion travel',
    'Responsible tourism',
  ],
  email: 'info@adventure-access.com',
  sameAs: [
    'https://www.instagram.com/adventureaccesstours/',
    'https://www.facebook.com/adventureaccesstours/',
    'https://www.youtube.com/channel/UCsokw2Ok93KwNdbQKVf9NyA',
    'https://twitter.com/TibetanAdvYeti',
  ],
  memberOf: [
    { '@type': 'Organization', name: 'Adventure Travel Trade Association' },
    { '@type': 'Organization', name: 'CREST — Center for Responsible Travel' },
    { '@type': 'Organization', name: "Tomorrow's Air" },
  ],
};

const extraSchemas: object[] = !schema ? [] : (Array.isArray(schema) ? schema : [schema]);
const allSchemas = [orgSchema, ...extraSchemas];
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content="Adventure Access" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:site" content="@TibetanAdvYeti" />

    <!-- Structured data -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)}></script>
    ))}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- ================= Consent-managed tracking =================
         Site-native consent (see ConsentBanner.astro). Behavior:
         - NOTHING loads unless the hostname is the live production site.
           Netlify deploy previews, branch deploys (*.netlify.app) and
           localhost therefore never report into the production GA4
           property. The consent banner still runs on those so it stays
           testable; it simply has nothing to switch on.
         - Staff carrying the internal-traffic flag are marked: GA4 gets
           traffic_type "internal" (which is what the GA4 Internal Traffic
           data filter matches on) and HubSpot + Reddit never load at all.
           Set the flag by visiting /?aa_internal=1 once in each browser
           and on each device; /?aa_internal=0 clears it. Unlike a GA4 IP
           rule this keeps working on hotel wifi, phones and tethering.
         - Google tag (GA4 G-447VPW2H83) loads immediately but with
           Consent Mode v2 defaults DENIED — cookieless until accepted.
         - HubSpot (244183775, also injects Google Ads AW-17730828816)
           and the Reddit pixel (a2_i0elr0ey0buk) load ONLY after accept.
         - Choice stored in localStorage ("aa-consent"); Global Privacy
           Control signals are honored as an automatic decline.
         - The Google Ads tag is intentionally NOT configured here:
           HubSpot injects it (Ads connected in HubSpot > Marketing > Ads).
    -->
    {!isInternalPage && (
    <script is:inline>
      (function () {
        var GA_ID = 'G-447VPW2H83';
        var CONSENT_KEY = 'aa-consent';
        var INTERNAL_KEY = 'aa-internal';
        var PROD_HOSTS = ['www.adventure-access.com', 'adventure-access.com'];

        function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function write(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function drop(k) { try { localStorage.removeItem(k); } catch (e) {} }

        // --- Internal-traffic flag ---------------------------------------
        // ?aa_internal=1 marks this browser as ours, and the mark persists,
        // so we each set it once per browser and per device and stay marked
        // wherever we happen to be. ?aa_internal=0 removes it.
        var params = null;
        try {
          params = new URLSearchParams(window.location.search);
          if (params.has('aa_internal')) {
            var flag = params.get('aa_internal');
            if (flag === '0' || flag === 'false') { drop(INTERNAL_KEY); } else { write(INTERNAL_KEY, '1'); }
            // Strip the marker from the address bar so it never ends up in
            // page_location, a shared link or a bookmark. Other query
            // params (notably the summit ?s= source codes) are preserved.
            if (window.history && window.history.replaceState) {
              params.delete('aa_internal');
              var rest = params.toString();
              window.history.replaceState({}, '', window.location.pathname + (rest ? '?' + rest : '') + window.location.hash);
            }
          }
        } catch (e) {}
        var isInternal = read(INTERNAL_KEY) === '1';

        // --- Production gate ---------------------------------------------
        var isProduction = PROD_HOSTS.indexOf(window.location.hostname) !== -1;

        var stored = read(CONSENT_KEY);

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;

        var GRANTED = {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        };

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });

        // ORDER MATTERS. A returning visitor who already accepted must have
        // consent upgraded BEFORE the gtag('config') below, because that call
        // is what sends the first page_view. Upgrading afterwards (as this
        // file did until 19 Sep 2026) meant every single page_view left the
        // browser under denied consent — cookieless, unattributed, and
        // invisible in standard reports. Only later events (scroll,
        // user_engagement) arrived properly, which is exactly what GA4 was
        // showing: engagement events and no pageviews at all.
        if (stored === 'granted') { gtag('consent', 'update', GRANTED); }

        gtag('js', new Date());

        var gaConfig = {};
        if (isInternal) { gaConfig.traffic_type = 'internal'; }
        gtag('config', GA_ID, gaConfig);

        if (isProduction) {
          var ga = document.createElement('script');
          ga.async = true;
          ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(ga);
        }

        function enableTracking() {
          gtag('consent', 'update', GRANTED);
          // Marketing pixels never load off production, nor for staff.
          if (!isProduction || isInternal) { return; }
          if (!document.getElementById('hs-script-loader')) {
            var hs = document.createElement('script');
            hs.id = 'hs-script-loader';
            hs.async = true;
            hs.defer = true;
            hs.src = 'https://js-na2.hs-scripts.com/244183775.js';
            document.head.appendChild(hs);
          }
          if (!window.rdt) {
            !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js";t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);
            window.rdt('init', 'a2_i0elr0ey0buk');
            window.rdt('track', 'PageVisit');
          }
        }

        function store(v) {
          write(CONSENT_KEY, v);
          window.aaConsent.status = v;
        }

        window.aaConsent = {
          status: stored,
          internal: isInternal,
          production: isProduction,
          accept: function () { store('granted'); enableTracking(); document.dispatchEvent(new CustomEvent('aa-consent-change')); },
          decline: function () { store('denied'); document.dispatchEvent(new CustomEvent('aa-consent-change')); },
          show: function () { document.dispatchEvent(new CustomEvent('aa-consent-show')); },
        };

        if (stored === 'granted') {
          enableTracking();
        } else if (!stored && navigator.globalPrivacyControl === true) {
          // Browser broadcasts a do-not-track/sell signal: honor it silently.
          store('denied');
        }
      })();
    </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <Nav transparent={hideNavBg} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {!isInternalPage && <ConsentBanner />}
    <RevealObserver />
  </body>
</html>
