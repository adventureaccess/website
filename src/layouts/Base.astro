---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RevealObserver from '../components/RevealObserver.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideNavBg?: boolean;
  /** Set true to emit a noindex tag (e.g. thank-you, search results). */
  noindex?: boolean;
  /** Optional extra JSON-LD blocks to append (Article, TouristTrip, Place, etc). */
  schema?: object | object[];
}

const {
  title = 'Adventure Access — Real Adventure Changes You',
  description = 'Custom-built adventure tours across the Himalayas and the Tibetan Plateau. Bhutan, India, Nepal, and Yunnan.',
  ogImage,
  hideNavBg = false,
  noindex = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteOgImage = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL('/images/2024/05/Ladakh-hero-image.jpg', Astro.site).toString();

// Organization schema — emitted on every page
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Adventure Access',
  legalName: 'Adventure Access, LLC',
  url: Astro.site?.toString() ?? 'https://www.adventure-access.com/',
  logo: new URL('/favicon.svg', Astro.site).toString(),
  description:
    'Custom adventure tours across the Himalayas and the Tibetan Plateau, with a community of local guides and operators in Bhutan, India, Nepal, and China.',
  areaServed: ['Bhutan', 'India', 'Nepal', 'China', 'Tibet'],
  knowsAbout: [
    'Himalayan trekking',
    'Tibetan Plateau travel',
    'Mountain biking',
    'Cultural immersion travel',
    'Responsible tourism',
  ],
  email: 'info@adventure-access.com',
  sameAs: [
    'https://www.instagram.com/adventureaccesstours/',
    'https://www.facebook.com/adventureaccesstours/',
    'https://www.youtube.com/channel/UCsokw2Ok93KwNdbQKVf9NyA',
    'https://twitter.com/TibetanAdvYeti',
  ],
  memberOf: [
    { '@type': 'Organization', name: 'Adventure Travel Trade Association' },
    { '@type': 'Organization', name: 'CREST — Center for Responsible Travel' },
    { '@type': 'Organization', name: "Tomorrow's Air" },
  ],
};

const extraSchemas: object[] = !schema ? [] : (Array.isArray(schema) ? schema : [schema]);
const allSchemas = [orgSchema, ...extraSchemas];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content="Adventure Access" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:site" content="@TibetanAdvYeti" />

    <!-- Structured data -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)}></script>
    ))}

    <!-- Netlify Identity email links (invite / password recovery / confirmation)
         point at the site root with the token in the URL hash. Forward those to
         /account/, hash intact, which handles every flow with visible success and
         failure states.

         This used to load the widget here and call open() blind, then redirect to
         /admin/ on login. If a token was expired or already spent — which happens
         a lot, since mail clients and security scanners pre-fetch links and these
         tokens are single-use — the verify call 404'd, nothing rendered, the hash
         was stripped, and the user was stranded on the homepage. Forwarding keeps
         the token handling in exactly one place, and keeps ~70KB of widget JS off
         normal page views. -->
    <script is:inline>
      (function () {
        var hash = window.location.hash || '';
        if (
          hash.indexOf('invite_token=') === -1 &&
          hash.indexOf('recovery_token=') === -1 &&
          hash.indexOf('confirmation_token=') === -1 &&
          hash.indexOf('email_change_token=') === -1
        ) return;

        // /account/ handles these itself — never forward to ourselves.
        if (window.location.pathname.indexOf('/account') === 0) return;

        window.location.replace('/account/' + hash);
      })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- ================= Consent-managed tracking =================
         Site-native consent (see ConsentBanner.astro). Behavior:
         - Google tag (GA4 G-447VPW2H83) loads immediately but with
           Consent Mode v2 defaults DENIED — cookieless until accepted.
         - HubSpot (244183775, also injects Google Ads AW-17730828816)
           and the Reddit pixel (a2_i0elr0ey0buk) load ONLY after accept.
         - Choice stored in localStorage ("aa-consent"); Global Privacy
           Control signals are honored as an automatic decline.
         - The Google Ads tag is intentionally NOT configured here:
           HubSpot injects it (Ads connected in HubSpot > Marketing > Ads).
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-447VPW2H83"></script>
    <script is:inline>
      (function () {
        var KEY = 'aa-consent';
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}

        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });
        gtag('js', new Date());
        gtag('config', 'G-447VPW2H83');

        function enableTracking() {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
          if (!document.getElementById('hs-script-loader')) {
            var hs = document.createElement('script');
            hs.id = 'hs-script-loader';
            hs.async = true;
            hs.defer = true;
            hs.src = 'https://js-na2.hs-scripts.com/244183775.js';
            document.head.appendChild(hs);
          }
          if (!window.rdt) {
            !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js";t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);
            window.rdt('init', 'a2_i0elr0ey0buk');
            window.rdt('track', 'PageVisit');
          }
        }

        function store(v) {
          try { localStorage.setItem(KEY, v); } catch (e) {}
          window.aaConsent.status = v;
        }

        window.aaConsent = {
          status: stored,
          accept: function () { store('granted'); enableTracking(); document.dispatchEvent(new CustomEvent('aa-consent-change')); },
          decline: function () { store('denied'); document.dispatchEvent(new CustomEvent('aa-consent-change')); },
          show: function () { document.dispatchEvent(new CustomEvent('aa-consent-show')); },
        };

        if (stored === 'granted') {
          enableTracking();
        } else if (!stored && navigator.globalPrivacyControl === true) {
          // Browser broadcasts a do-not-track/sell signal: honor it silently.
          store('denied');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <Nav transparent={hideNavBg} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <RevealObserver />
  </body>
</html>
